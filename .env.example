# ============================================
# Telegram Fixed-Reply Bot - 配置模板
# ============================================
# 使用说明：
#   1. 复制此文件为 .env
#   2. 填入你的配置值（.env 不要提交到版本控制）
#   3. 运行: python ai/client6_public.py
#
# 获取 Telegram API 凭证:
#   https://my.telegram.org/apps
# ============================================

# Telegram API 凭证（必填）
# 从 https://my.telegram.org/apps 获取
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# SOCKS5 代理（可选，如遇网络封锁需配置）
# 格式: socks5://127.0.0.1:7890
TELEGRAM_PROXY=

# 推广链接（可选，默认使用示例链接）
DOWNLOAD_LINK=https://example.com/your-link

# 是否处理启动前的未读消息（默认关闭）
PROCESS_OFFLINE=false